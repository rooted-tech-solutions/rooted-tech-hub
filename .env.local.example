# Supabase — both are safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://iaenkvmznohyzbgqoirk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role — SERVER ONLY. Bypasses row-level security entirely.
# Never add a NEXT_PUBLIC_ prefix and never reference it from client code.
# Used by the public inquiry form so the `anon` grant on submit_inquiry can be
# revoked (see supabase/migrations/008), leaving the server action the only
# way in. Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email. The Hub sends the client's invoice (with a Pay button), plus two
# alerts to the owner. Whichever of these is configured is used, in this order:
#
#   1. Gmail SMTP — sends from the business Gmail address to anyone. Free.
#      Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#   2. Resend — only delivers to the account owner's own address until a domain
#      is DNS-verified. Once one is, remove the Gmail vars and this takes over.
RESEND_API_KEY=

# Cloudflare Turnstile — anti-spam on the inquiry form.
# Needs a Cloudflare account with a domain registered. Both blank = inert.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
